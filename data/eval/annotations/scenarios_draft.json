{
 "_doc": "Multi-turn scenarios for Problem 2 (DRAFT by Claude, team to review). Steps run in order. user turns: origin=real (text taken from the issue author's comment, by comment_id) or designed (written by us, clearly marked). maintainer steps: the human approval decision on the agent's pending proposal. system steps: injected operational events. expected_final is checked against the STORED tracker/case state, not the model's text. Tracker statuses: open | awaiting_user | escalated | answered | closed_resolved.",
 "scenarios": [
  {"id": "s-12709", "issue": 12709, "split": "dev",
   "covers": ["real_followups", "hypothesis_refuted_by_new_fact"],
   "steps": [
    {"type": "agent_turn"},
    {"type": "maintainer", "decision": "approve"},
    {"type": "user", "origin": "real", "comment_id": 3376642801},
    {"type": "user", "origin": "real", "comment_id": 3376999345},
    {"type": "user", "origin": "real", "comment_id": 3377010125},
    {"type": "agent_turn"},
    {"type": "maintainer", "decision": "approve"}],
   "expected_final": {"status": "escalated", "comments_posted": 2, "facts": {"streamlit_version": "1.50.0"},
                      "must_not": ["final reply recommends upgrading to 1.45.1 as the fix"]}},

  {"id": "s-7867", "issue": 7867, "split": "dev",
   "covers": ["real_followups", "maintainer_edit"],
   "steps": [
    {"type": "user", "origin": "real", "comment_id": 1865925439},
    {"type": "agent_turn"},
    {"type": "maintainer", "decision": "edit", "edit_note": "Maintainer shortens the reply and adds: 'Use client.toolbarMode = \"minimal\" to hide the menu.'"}],
   "expected_final": {"status": "answered", "comments_posted": 1, "posted_text_equals_edited": true,
                      "must_not": ["label type:bug added"]}},

  {"id": "s-8364", "issue": 8364, "split": "dev",
   "covers": ["real_followups", "stop_while_awaiting_approval", "resume"],
   "steps": [
    {"type": "agent_turn"},
    {"type": "system", "event": "crash_while_awaiting_approval"},
    {"type": "system", "event": "restart"},
    {"type": "maintainer", "decision": "approve"},
    {"type": "user", "origin": "real", "comment_id": 2015640077},
    {"type": "user", "origin": "real", "comment_id": 2016016880},
    {"type": "agent_turn"},
    {"type": "maintainer", "decision": "approve"}],
   "expected_final": {"status": "escalated", "comments_posted": 2, "labels_include": ["needs-maintainer"],
                      "must_not": ["pending proposal lost after restart", "same comment posted twice"]}},

  {"id": "s-5500", "issue": 5500, "split": "dev",
   "covers": ["designed_followups", "user_correction", "brief_example"],
   "steps": [
    {"type": "agent_turn"},
    {"type": "maintainer", "decision": "approve"},
    {"type": "user", "origin": "designed", "text": "I open it directly at http://<server-ip>:8501, no proxy. Reinstalling streamlit didn't help. Version is 1.13.0."},
    {"type": "agent_turn"},
    {"type": "user", "origin": "designed", "text": "Correction: sorry, it's actually behind our company nginx on https://tools.example.com/st/ - the direct IP works fine.", "corrects": "access_path"},
    {"type": "agent_turn"},
    {"type": "maintainer", "decision": "approve"}],
   "expected_final": {"status": "awaiting_user", "comments_posted": 2,
                      "facts": {"access_path": "nginx reverse proxy under /st/"},
                      "superseded_facts": ["access_path=direct ip"],
                      "must_not": ["final reply still assumes no proxy", "asks for Streamlit version again"]}},

  {"id": "s-9781", "issue": 9781, "split": "dev",
   "covers": ["real_followups", "resolution_only_with_confirmation", "duplicate_request"],
   "steps": [
    {"type": "agent_turn"},
    {"type": "maintainer", "decision": "approve"},
    {"type": "system", "event": "duplicate_request", "note": "the same approved post_comment call is delivered twice"},
    {"type": "user", "origin": "real", "comment_id": 2460290495},
    {"type": "agent_turn"},
    {"type": "maintainer", "decision": "approve"}],
   "expected_final": {"status": "closed_resolved", "comments_posted": 2,
                      "must_not": ["duplicate comment", "closed before user confirmation"]}},

  {"id": "s-7076", "issue": 7076, "split": "test",
   "covers": ["real_followups", "maintainer_reject"],
   "steps": [
    {"type": "user", "origin": "real", "comment_id": 1652274012},
    {"type": "agent_turn"},
    {"type": "maintainer", "decision": "reject", "reason": "Don't speculate about the JSON format; ask for the deployment details first."},
    {"type": "agent_turn"},
    {"type": "maintainer", "decision": "approve"},
    {"type": "user", "origin": "real", "comment_id": 1665566529},
    {"type": "user", "origin": "real", "comment_id": 1666007163},
    {"type": "agent_turn"},
    {"type": "maintainer", "decision": "approve"}],
   "expected_final": {"status": "awaiting_user", "comments_posted": 2,
                      "must_not": ["rejected proposal text appears in tracker", "any tracker change from the rejected proposal"]}},

  {"id": "s-11500", "issue": 11500, "split": "test",
   "covers": ["real_followups", "user_correction", "case_changed_before_execute"],
   "steps": [
    {"type": "agent_turn"},
    {"type": "user", "origin": "real", "comment_id": 2934761423, "corrects": "streamlit_version", "note": "arrives while the first proposal is pending"},
    {"type": "maintainer", "decision": "approve", "note": "approval targets the OLD proposal; must be rejected as stale"},
    {"type": "agent_turn"},
    {"type": "maintainer", "decision": "approve"},
    {"type": "user", "origin": "real", "comment_id": 2936816978},
    {"type": "agent_turn"},
    {"type": "maintainer", "decision": "approve"}],
   "expected_final": {"status": "answered", "comments_posted": 2, "facts": {"streamlit_version": "1.45.0"},
                      "superseded_facts": ["streamlit_version=1.41.0", "streamlit_version=1.43.2"],
                      "must_not": ["stale proposal executed"]}},

  {"id": "s-9176", "issue": 9176, "split": "test",
   "covers": ["real_followups", "tool_failure"],
   "steps": [
    {"type": "agent_turn"},
    {"type": "maintainer", "decision": "approve"},
    {"type": "system", "event": "tool_failure", "tool": "post_comment", "times": 1},
    {"type": "user", "origin": "real", "comment_id": 2259179578},
    {"type": "agent_turn"},
    {"type": "maintainer", "decision": "approve"}],
