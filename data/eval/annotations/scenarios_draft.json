    {"type": "agent_turn"},
    {"type": "maintainer", "decision": "approve"},
    {"type": "system", "event": "switch_case", "to": "s-9140"},
    {"type": "user", "origin": "real", "comment_id": 3019420957},
    {"type": "agent_turn"},
    {"type": "maintainer", "decision": "approve"}],
   "expected_final": {"status": "answered", "comments_posted": 2,
                      "must_not": ["facts from #9140 (tornado, Windows) appear in this case", "approval from #9140 used here"]}},

  {"id": "s-9140", "issue": 9140, "split": "test",
   "covers": ["real_followups", "case_switch"],
   "interleave_with": "s-11509",
   "steps": [
    {"type": "agent_turn"},
    {"type": "system", "event": "switch_case", "to": "s-11509"},
    {"type": "maintainer", "decision": "approve"},
    {"type": "user", "origin": "real", "comment_id": 2257412986},
    {"type": "agent_turn"},
    {"type": "maintainer", "decision": "approve"}],
   "expected_final": {"status": "escalated", "comments_posted": 2, "facts": {"tornado_version": "6.4.1"},
                      "must_not": ["facts from #11509 appear in this case"]}},

  {"id": "s-15378", "issue": 15378, "split": "test",
   "covers": ["real_followups", "step_limit"],
   "steps": [
    {"type": "agent_turn"},
    {"type": "maintainer", "decision": "approve"},
    {"type": "user", "origin": "real", "comment_id": 4599319685},
    {"type": "agent_turn"},
    {"type": "maintainer", "decision": "approve"}],
   "expected_final": {"status": "escalated", "comments_posted": 2,
                      "must_not": ["repeats the server.address suggestion the user already tried", "exceeds step budget"]}}
 ]
