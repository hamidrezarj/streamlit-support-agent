# Copy to .env and fill in. Never commit .env.
# GitHub: fine-grained token, read-only access to public repositories is enough.
GITHUB_TOKEN=

# Metis gateway (OpenAI-compatible). Copy the base URL and key from your Metis panel.
LLM_BASE_URL=https://api.metisai.ir/openai/v1
LLM_API_KEY=
EMBED_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini

# Team budget guard (USD). Calls stop before the ledger would exceed this.
BUDGET_USD=5.0
# Optional price overrides, USD per 1M tokens: PRICE_<MODEL>_IN / PRICE_<MODEL>_OUT
